<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.GenericChannelSelectorView">

    <ContentView.Content>
        <Grid ColumnDefinitions="*,*">
            <Label Grid.Column="0" Text="{extensions:Translate Channel}"/>
            <Picker Grid.Column="1" x:Name="ChannelPicker"
                Title="{extensions:Translate Channel}"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                SelectedIndexChanged="OnChannelPickerSelectedIndexChanged"/>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

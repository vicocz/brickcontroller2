<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls" xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.MK5ChannelSelectorView">

    <ContentView.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <controls:ChannelSelectorRadioButton x:Name="MK5Channel2" Channel="2" HorizontalOptions="End" VerticalOptions="Start"/>
                <controls:ChannelSelectorRadioButton x:Name="MK5Channel0" Channel="0" HorizontalOptions="End" VerticalOptions="End"/>
            </Grid>

            <Grid Grid.Column="1">
                <Image Source="{extensions:ImageResource Source=mk5_image.png}" WidthRequest="150" HeightRequest="112"/>
            </Grid>

            <Grid Grid.Column="2">
                <controls:ChannelSelectorRadioButton x:Name="MK5Channel1" Channel="1" HorizontalOptions="Start" VerticalOptions="Start"/>
                <controls:ChannelSelectorRadioButton x:Name="MK5Channel4" Channel="4" HorizontalOptions="Start" VerticalOptions="Center"/>
                <controls:ChannelSelectorRadioButton x:Name="MK5Channel3" Channel="3" HorizontalOptions="Start" VerticalOptions="End"/>
            </Grid>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

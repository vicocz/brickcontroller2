<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls" xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.PowerBoxMBatteryChannelSelectorView">

    <ContentView.Content>
        <Grid x:Name="PowerBoxMBatterySection" RowDefinitions="Auto" ColumnDefinitions="*,Auto,*">
            <controls:ChannelSelectorRadioButton Grid.Column="0" x:Name="PowerBoxMBatteryChannel0" Channel="0" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,20,0"/>
            <Image Grid.Column="1" Source="{extensions:ImageResource Source=powerboxmbattery_image.png}" WidthRequest="128" HeightRequest="113" HorizontalOptions="Center" VerticalOptions="Start"/>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

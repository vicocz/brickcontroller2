<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls" xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.PowerFunctionsChannelSelectorView">

    <ContentView.Content>
        <Grid ColumnDefinitions="*,Auto,*">

            <controls:ChannelSelectorRadioButton Grid.Column="0" x:Name="PowerFunctionsChannel0" Channel="0" HorizontalOptions="End" VerticalOptions="End"/>
            <Image Grid.Column="1" Source="{extensions:ImageResource Source=powerfunctions_image.png}" WidthRequest="150" HeightRequest="150"/>
            <controls:ChannelSelectorRadioButton Grid.Column="2" x:Name="PowerFunctionsChannel1" Channel="1" HorizontalOptions="Start" VerticalOptions="End"/>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls" xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.TechnicMoveChannelSelectorView">

    <ContentView.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <controls:ChannelSelectorRadioButton Grid.Column="1" Grid.Row="0" x:Name="TechnicMoveChannelA" Channel="0" HorizontalOptions="Center" VerticalOptions="Center"/>
            <controls:ChannelSelectorRadioButton Grid.Column="0" Grid.Row="1" x:Name="TechnicMoveChannelB" Channel="1" HorizontalOptions="End" VerticalOptions="End"/>
            <controls:ChannelSelectorRadioButton Grid.Column="0" Grid.Row="1" x:Name="TechnicMoveChannelAB" Channel="12" HorizontalOptions="End" VerticalOptions="End"/>
            <controls:ChannelSelectorRadioButton Grid.Column="2" Grid.Row="1" x:Name="TechnicMoveChannelC" Channel="2" HorizontalOptions="Start" VerticalOptions="End"/>
            <controls:ChannelSelectorRadioButton Grid.Column="2" Grid.Row="1" x:Name="TechnicMoveChannel1" Channel="3" HorizontalOptions="Start" VerticalOptions="Start" Margin="5,0,0,0"/>
            <controls:ChannelSelectorRadioButton Grid.Column="1" Grid.Row="1" x:Name="TechnicMoveChannel2" Channel="4" HorizontalOptions="End" VerticalOptions="Start"/>
            <controls:ChannelSelectorRadioButton Grid.Column="1" Grid.Row="2" x:Name="TechnicMoveChannel3" Channel="5" HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,10,0"/>
            <controls:ChannelSelectorRadioButton Grid.Column="1" Grid.Row="2" x:Name="TechnicMoveChannel4" Channel="6" HorizontalOptions="End" VerticalOptions="Start" Margin="0,0,55,0"/>
            <controls:ChannelSelectorRadioButton Grid.Column="1" Grid.Row="0" x:Name="TechnicMoveChannel5" Channel="7" HorizontalOptions="Start" VerticalOptions="End"/>
            <controls:ChannelSelectorRadioButton Grid.Column="0" Grid.Row="1" x:Name="TechnicMoveChannel6" Channel="8" HorizontalOptions="End" VerticalOptions="Start"/>

            <Image Grid.Column="1" Grid.Row="1" Source="{extensions:ImageResource Source=technicmove_image.png}" WidthRequest="150" HeightRequest="80" ZIndex="-1"/>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

<?xml version="1.0" encoding="UTF-8"?>
<devices:DeviceChannelSelectorViewBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls" xmlns:devices="clr-namespace:BrickController2.UI.Controls.Devices"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    x:Class="BrickController2.UI.Controls.Devices.WeDo2ChannelSelectorView">

    <ContentView.Content>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <controls:ChannelSelectorRadioButton x:Name="WedoChannel1" DeviceType="WeDo2" Channel="1" HorizontalOptions="End" VerticalOptions="Start"/>
                <controls:ChannelSelectorRadioButton x:Name="WedoChannel0" DeviceType="WeDo2" Channel="0" HorizontalOptions="End" VerticalOptions="End"/>
            </Grid>

            <Image Grid.Column="1" Source="{extensions:ImageResource Source=wedo2_image.png}" WidthRequest="150" HeightRequest="120"/>

            <Grid Grid.Column="2"/>
        </Grid>
    </ContentView.Content>

</devices:DeviceChannelSelectorViewBase>

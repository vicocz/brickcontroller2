<?xml version="1.0" encoding="utf-8" ?>
<local:PageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    xmlns:local="clr-namespace:BrickController2.UI.Pages"
    xmlns:viewModels="clr-namespace:BrickController2.UI.ViewModels"
    x:Class="BrickController2.UI.Pages.HelpPage"
    x:DataType="viewModels:HelpPageViewModel"
    Title="{Binding Title}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <ContentPage.ToolbarItems>
        <controls:ToolbarIcon Icon="navigate_before" Text="{extensions:Translate Back}" Command="{Binding GoBackCommand}" />
        <controls:ToolbarIcon Icon="navigate_next" Text="{extensions:Translate Forward}" Command="{Binding GoForwardCommand}" />
    </ContentPage.ToolbarItems>

    <local:PageBase.Content>
        <AbsoluteLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <WebView x:Name="HelpView" Source="{Binding Source}" Navigating="OnNavigating"
                     AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All"/>

            <controls:Dialogs x:Name="Dialogs" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All"/>
        </AbsoluteLayout>
    </local:PageBase.Content>
</local:PageBase>

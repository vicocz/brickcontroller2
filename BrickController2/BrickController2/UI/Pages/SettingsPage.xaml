<?xml version="1.0" encoding="utf-8" ?>
<local:PageBase
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:BrickController2.UI.Controls"
    xmlns:converters="clr-namespace:BrickController2.UI.Converters"
    xmlns:extensions="clr-namespace:BrickController2.UI.MarkupExtensions"
    xmlns:local="clr-namespace:BrickController2.UI.Pages"
    xmlns:settings="clr-namespace:BrickController2.UI.Services.Settings"
    xmlns:viewModels="clr-namespace:BrickController2.UI.ViewModels"
    x:Class="BrickController2.UI.Pages.SettingsPage"
    x:DataType="viewModels:SettingsPageViewModel"
    Title="{extensions:Translate Settings}"
    BackgroundColor="{DynamicResource PageBackgroundColor}">

    <local:PageBase.Resources>
        <ResourceDictionary>
            <converters:ThemeStyleToBoolConverter x:Key="ThemeTypeToBool"/>
            <converters:IsStringNotNullOrEmptyConverter x:Key="IsNotEmpty"/>

            <!-- Picker row: label, picker button, optional status line and divider -->
            <DataTemplate x:Key="PickerTemplate" x:DataType="settings:ISettingsItem">
                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto,Auto" IsVisible="{Binding IsVisible}">
                    <Label Text="{Binding Title}" FontSize="Large" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="{Binding Value}" Command="{Binding Command}" Style="{StaticResource PickerButtonStyle}" HorizontalOptions="FillAndExpand"/>
                    <!-- hidden when empty so rows without status get no extra gap -->
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Status}" IsVisible="{Binding Status, Converter={StaticResource IsNotEmpty}}" FontSize="Small" Margin="0,5,0,0"/>
                    <BoxView Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DividerBoxViewStyle}" Margin="5,10,5,10"/>
                </Grid>
            </DataTemplate>

            <!-- Toggle row: label, switch and divider -->
            <DataTemplate x:Key="ToggleTemplate" x:DataType="settings:ISettingsToggleItem">
                <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,Auto" IsVisible="{Binding IsVisible}">
                    <Label Text="{Binding Title}" FontSize="Large" VerticalOptions="Center"/>
                    <Switch Grid.Column="1" IsToggled="{Binding IsToggled, Mode=TwoWay}" HorizontalOptions="End" VerticalOptions="Center"/>
                    <BoxView Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource DividerBoxViewStyle}" Margin="5,10,5,10"/>
                </Grid>
            </DataTemplate>

            <local:SettingsItemTemplateSelector x:Key="SettingsItemTemplateSelector"
                                                PickerTemplate="{StaticResource PickerTemplate}"
                                                ToggleTemplate="{StaticResource ToggleTemplate}"/>
        </ResourceDictionary>
    </local:PageBase.Resources>

    <local:PageBase.Content>
        <AbsoluteLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid RowSpacing="0" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All">

                <!-- All settings rows (built-in and platform) rendered generically -->
                <VerticalStackLayout Margin="20"
                                     BindableLayout.ItemsSource="{Binding SettingsItems}"
                                     BindableLayout.ItemTemplateSelector="{StaticResource SettingsItemTemplateSelector}"/>

            </Grid>

            <controls:Dialogs x:Name="Dialogs" AbsoluteLayout.LayoutBounds="0, 0, 1, 1" AbsoluteLayout.LayoutFlags="All"/>

        </AbsoluteLayout>
    </local:PageBase.Content>
    
</local:PageBase>